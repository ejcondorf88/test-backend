# ============================================
# CONFIGURACIÓN DE LA BASE DE DATOS
# ============================================

# Nombre de la base de datos
POSTGRES_DB=uqai_db

# Usuario de la base de datos
POSTGRES_USER=uqai_user

# Contraseña de la base de datos (cámbiala si quieres)
POSTGRES_PASSWORD=uqai_pass

# Puerto de la base de datos
POSTGRES_PORT=5432

# ============================================
# CONFIGURACIÓN DEL CREDIT CARD SERVICE
# ============================================

# Puerto donde correrá el servicio de tarjetas
CREDITCARD_PORT=8080

# ============================================
# CONFIGURACIÓN DEL OPERATIONS SERVICE
# ============================================

# Puerto donde correrá el servicio de operaciones
OPERATIONS_PORT=8081

# URL del servicio de tarjetas (no cambiar)
CREDITCARD_SERVICE_URL=http://creditcard-service:8080